{
  "languages": {
    "HTML": {
      "format_on_save": "on"
    },
    "JavaScript": {
      "format_on_save": "on"
    },
    "JSON": {
      "format_on_save": "on"
    },
    "Markdown": {
      "format_on_save": "on"
    },
    "MDX": {
      "format_on_save": "on"
    },
    "TypeScript": {
      "format_on_save": "on"
    }
  },
  "semantic_tokens": "combined",
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cva", "cx"],
        "experimental": {
          "classRegex": ["class=\"([^\"]*)\""]
        }
      }
    }
  }
}
