{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npx tsx ../scripts/with-env.ts concurrently \"tsx ../scripts/build-docs-manifest.ts --watch\" \"tsx ./scripts/run-ng-with-runtime.ts serve\"",
    "start:e2e": "npx tsx ../scripts/with-env.ts sh -c 'tsx ../scripts/build-docs-manifest.ts && NG_CACHE_DIR=.angular/cache-e2e tsx ./scripts/run-ng-with-runtime.ts serve --configuration=e2e'",
    "serve:prod": "npx serve dist/frontend/browser -l 4201 -s",
    "prebuild": "tsx ../scripts/build-docs-manifest.ts",
    "build": "npx tsx ../scripts/with-env.ts tsx ./scripts/run-ng-with-runtime.ts build",
    "build:preview": "npx tsx ../scripts/with-env.ts sh -c 'tsx ../scripts/build-docs-manifest.ts && tsx ./scripts/run-ng-with-runtime.ts build --configuration=preview'",
    "build:e2e": "npx tsx ../scripts/with-env.ts sh -c 'tsx ../scripts/build-docs-manifest.ts && NG_CACHE_DIR=.angular/cache-e2e tsx ./scripts/run-ng-with-runtime.ts build --configuration=e2e'",
    "watch": "npx tsx ../scripts/with-env.ts tsx ./scripts/run-ng-with-runtime.ts build --watch --configuration=development",
    "screenshot": "tsx scripts/capture-screenshot.ts",
    "test": "npx tsx ../scripts/with-env.ts vitest run",
    "test:debug": "npx tsx ../scripts/with-env.ts env VITEST_VERBOSE=1 vitest run",
    "test:report": "npx tsx ../scripts/with-env.ts env VITEST_VERBOSE=1 VITEST_JSON=1 vitest run",
    "test:watch": "npx tsx ../scripts/with-env.ts vitest",
    "lint": "npx tsx ../scripts/with-env.ts npx ng lint frontend --max-warnings=-1",
    "lint:verbose": "npx tsx ../scripts/with-env.ts npx ng lint frontend --verbose --max-warnings=-1",
    "fix": "eslint --config eslint.config.mjs \"src/**/*.{ts,html}\" --fix",
    "deploy": "wrangler pages deploy dist/frontend/browser",
    "analyze": "ng build --configuration=production --stats-json && npx vite-bundle-analyzer dist/frontend/browser/stats.json",
    "bundle-size": "size-limit",
    "storybook": "ng run frontend:storybook",
    "build-storybook": "ng run frontend:build-storybook",
    "audit:visual": "AUDIT_LLM_PROVIDER=skip AUDIT_SUITE=1 pnpm --dir .. test:e2e -- --build --project audit",
    "audit:visual:llm": "AUDIT_SUITE=1 pnpm --dir .. test:e2e -- --build --project audit"
  },
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@angular/cdk": "^21.2.6",
    "@angular/common": "^21.2.8",
    "@angular/core": "^21.2.8",
    "@angular/forms": "^21.2.8",
    "@angular/platform-browser": "^21.2.8",
    "@angular/router": "^21.2.8",
    "@convex-dev/better-auth": "^0.11.4",
    "@sentry/angular": "^10.32.1",
    "@stripe/connect-js": "^3.3.35",
    "@stripe/stripe-js": "^9.2.0",
    "apexcharts": "^5.10.4",
    "better-auth": "1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.34.1",
    "convex-angular": "1.6.0",
    "flexsearch": "^0.8.212",
    "highlight.js": "^11.11.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "marked": "^17.0.5",
    "ng-apexcharts": "^2.3.0",
    "ngx-markdown": "^21.2.0",
    "ngx-sonner": "^3.1.0",
    "posthog-js": "^1.371.2",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.4.0",
    "tslib": "^2.3.0",
    "web-haptics": "^0.0.6"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.4.10",
    "@angular-devkit/architect": "^0.2102.8",
    "@angular-devkit/build-angular": "^21.2.8",
    "@angular-devkit/core": "^21.2.8",
    "@angular/build": "^21.2.8",
    "@angular/cli": "^21.2.8",
    "@angular/compiler-cli": "^21.2.8",
    "@anthropic-ai/sdk": "^0.86.1",
    "@axe-core/playwright": "^4.11.1",
    "@codecov/vite-plugin": "^2.0.1",
    "@compodoc/compodoc": "^1.1.26",
    "@ngx-playwright/test": "^0.6.1",
    "@playwright/test": "^1.59.0",
    "@size-limit/preset-app": "^11.2.0",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-themes": "^10.3.5",
    "@storybook/angular": "^10.3.5",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@vitest/coverage-v8": "^4.1.4",
    "concurrently": "^9.2.1",
    "convex-helpers": "^0.1.114",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.6",
    "serve": "^14.2.6",
    "size-limit": "^11.2.0",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite-bundle-analyzer": "^1.3.6",
    "vitest": "^4.1.4",
    "wrangler": "^4.59.1"
  }
}
