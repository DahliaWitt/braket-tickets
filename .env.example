# Braket Tickets Environment Variables
#
# Copy this to .env.local, then: set -a; source .env.local; set +a; pnpm dev
#
# MINIMUM REQUIRED: Only DOPPLER_INJECTED=1 is needed to run `pnpm dev`.
# The dev harness generates safe defaults for URLs, auth secrets, and CORS.
# Fill in additional credentials only for the features you're working on.
#
# For production deployments, use Doppler (https://doppler.com) as the single source of truth.
# See docs/environment.md for detailed configuration instructions.

# ─────────────────────────────────────────────────────────────────────────────
# DOPPLER BYPASS
# ─────────────────────────────────────────────────────────────────────────────

# Set to 1 to skip the Doppler CLI requirement.
# Without this, pnpm dev / pnpm test:frontend / pnpm validate will exit
# immediately with "ERROR: Doppler CLI is required".
DOPPLER_INJECTED=1

# ─────────────────────────────────────────────────────────────────────────────
# CONVEX (Backend & Database)
# ─────────────────────────────────────────────────────────────────────────────

# Backend/database URL. Local development defaults to http://127.0.0.1:3210
CONVEX_URL=http://127.0.0.1:3210

# Site URL for Convex integration. Optional — derived from CONVEX_URL if not set.
CONVEX_SITE_URL=http://127.0.0.1:3211

# Production Convex URL (safety guard). Only set in production environments.
# Used to prevent accidental syncs to production from development contexts.
PROD_CONVEX_URL=

# Canonical public deployment URL. Used to build redirect URLs in auth callbacks,
# email templates (magic links, invites, broadcasts), and Stripe Connect onboarding.
# The dev harness overrides this automatically, but the default should match the
# Angular dev server port (4200).
SITE_URL=http://localhost:4200

# Base URL for auth callbacks (OAuth redirects).
# Points to the Convex site URL (port 3211 locally), not the frontend.
AUTH_BASE_URL=http://127.0.0.1:3211

# ─────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION (Better Auth + OAuth Providers)
# ─────────────────────────────────────────────────────────────────────────────

# Better Auth signing secret. The dev harness uses this default if unset.
# For production, generate a real secret: openssl rand -hex 32
BETTER_AUTH_SECRET=local-dev-only-not-secure-change-me

# Google OAuth credentials (social login).
# Obtain from: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth credentials (social login).
# Obtain from: Discord Developer Portal → Applications → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Allow localhost/127.0.0.1 CORS origins. Set to 'true' for local development only.
# NEVER enable in production.
ALLOW_LOCALHOST_CORS=true

# ─────────────────────────────────────────────────────────────────────────────
# STRIPE (Payments)
# ─────────────────────────────────────────────────────────────────────────────

# Stripe publishable key (frontend, embedded checkout).
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_

# Stripe secret key (backend, server-side operations).
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_

# Stripe webhook signing secrets. Generate new endpoints in Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_WEBHOOK_SECRET_CONNECT=whsec_
STRIPE_WEBHOOK_SECRET_V2_EVENTS=whsec_

# Stripe sandbox connected account ID. Used by automated fixture seeding.
# For testing: use a Stripe test account connected to your platform account.
STRIPE_SANDBOX_CONNECTED_ACCOUNT_ID=acct_test_

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL (Resend + SMTP Fallback)
# ─────────────────────────────────────────────────────────────────────────────

# Resend API key (primary email delivery).
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_

# Resend webhook signing secret (for bounce/complaint handling).
# Get from: https://resend.com/webhooks
RESEND_WEBHOOK_SECRET=whsec_

# Primary sender email address (displayed to recipients).
EMAIL_FROM=tickets@braket.gay

# Optional reply-to address.
EMAIL_REPLY_TO=contact@braket.gay

# SMTP fallback (Ethereal for local/staging preview, Gmail for production fallback).
# Local/Staging example (Ethereal preview):
#   SMTP_HOST=smtp.ethereal.email
#   SMTP_PORT=587
#   SMTP_USER=ethereal_user@example.com
#   SMTP_PASS=ethereal_password
#
# Production fallback (Gmail):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=<fallback-sender@example.com>
#   SMTP_PASS=<google-workspace-app-password>

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=ethereal_user@example.com
SMTP_PASS=ethereal_password
SMTP_FROM=ethereal_user@example.com
SMTP_REPLY_TO=

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCT ANALYTICS (PostHog)
# ─────────────────────────────────────────────────────────────────────────────

# PostHog project API key (backend events).
# Get from: https://posthog.com/app/project/settings
POSTHOG_API_KEY=

# PostHog API host (e.g., https://us.i.posthog.com).
# Default: https://us.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com

# PostHog client key (frontend analytics).
# Get from: https://posthog.com/app/project/settings
POSTHOG_KEY=

# PostHog production logs project token (for log forwarding).
POSTHOG_LOGS_PROJECT_TOKEN=
POSTHOG_LOGS_HOST=https://us.i.posthog.com
POSTHOG_LOGS_SERVICE_NAME=

# PostHog development logs project token (for dev/staging log forwarding).
POSTHOG_DEV_LOGS_PROJECT_TOKEN=
POSTHOG_DEV_LOGS_HOST=https://us.i.posthog.com
POSTHOG_DEV_LOGS_SERVICE_NAME=

# ─────────────────────────────────────────────────────────────────────────────
# ERROR TRACKING (Sentry)
# ─────────────────────────────────────────────────────────────────────────────

# Sentry DSN (frontend error tracking).
# Get from: https://sentry.io/settings/projects/
SENTRY_DSN=

# Sentry DSN for development environment.
SENTRY_DSN_DEVELOPMENT=

# Sentry DSN for production (fallback if PostHog log forwarding fails).
# See docs/environment.md for rollback instructions.
# SENTRY_DSN_PRODUCTION=

# ─────────────────────────────────────────────────────────────────────────────
# DEPLOYMENT & BUILD
# ─────────────────────────────────────────────────────────────────────────────

# Log sink for Convex observability (e.g., 'posthog', 'sentry').
# Default: posthog
CONVEX_LOG_SINK=posthog

# Dev/staging log sink for Convex observability.
# Default: posthog
CONVEX_DEV_LOG_SINK=posthog

# Build timestamp (ISO 8601 or descriptive string). Auto-set in CI.
BUILD_TIMESTAMP=

# Test mode flag. Set to 'true' for automated tests.
IS_TEST=false

# CI environment variables (set automatically by GitHub Actions).
# No need to set locally.
GITHUB_SHA=
GITHUB_REF_NAME=

# ─────────────────────────────────────────────────────────────────────────────
# NOTES
# ─────────────────────────────────────────────────────────────────────────────
#
# Local Development:
#   1. Copy this file to .env.local
#   2. Fill in placeholder values
#   3. For OAuth, get credentials from Google Cloud / Discord Developer portals
#   4. For Stripe, use test API keys from https://dashboard.stripe.com/apikeys
#   5. For email, use Ethereal (free) for preview: https://ethereal.email/
#   6. Run: pnpm install && pnpm dev
#
# To use .env.local, export the variables first:
#   set -a; source .env.local; set +a
#   pnpm dev
#
# However, Doppler is recommended for production deployments:
#   doppler login
#   pnpm dev  # Doppler auto-loads the 'local' config
#
# See docs/environment.md for detailed configuration instructions, including:
# - Generating OAuth credentials
# - Stripe webhook setup
# - Email provider configuration
# - Deployment to staging/production
