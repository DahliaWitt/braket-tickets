# Copy to .act.secrets and fill in values.
# Or generate automatically from Doppler:
#   doppler secrets download --project braket-tickets --config stg --format env --no-file \
#     | grep -E '^(SMTP_|CONVEX_DEPLOY|CODECOV|STRIPE_SECRET_KEY|STRIPE_WEBHOOK)' > .act.secrets

# --- E2E job ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- lint job ---
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=

# --- test job ---
CODECOV_TOKEN=

# --- stripe-contracts job ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_V2_EVENTS=
