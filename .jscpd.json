{
  "threshold": 10,
  "reporters": ["html", "console", "json"],
  "ignore": [
    "**/node_modules/**",
    "**/.angular/**",
    "**/_generated/**",
    "**/dist/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/reports/**",
    "**/*.md",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.e2e-spec.ts",
    "**/*.harness.ts",
    "**/*.stories.ts",
