{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "check:authz-boundaries": "tsx scripts/check-authz-boundaries.ts",
    "check:generated": "tsx scripts/check-convex-generated.ts",
    "check:logging": "tsx scripts/check-convex-logging.ts",
    "lint": "eslint --config eslint.convex.config.mjs \"convex/**/*.ts\"",
    "seed": "tsx scripts/seed.ts --target local",
    "seed:dev": "DOPPLER_CONFIG=stg tsx scripts/seed.ts --target dev",
    "seed:dev:clear": "DOPPLER_CONFIG=stg tsx scripts/seed.ts --target dev --clear-only",
    "seed:dev:fresh": "DOPPLER_CONFIG=stg tsx scripts/seed.ts --target dev --fresh",
    "seed:fresh": "tsx scripts/seed.ts --target local --fresh",
    "seed:fixture": "tsx scripts/seed.ts --fixture",
    "seed:sandbox:fixture": "DOPPLER_CONFIG=stg tsx scripts/seed.ts --target dev --fixture",
    "sync:env:dev": "tsx scripts/sync-env.ts --dev",
    "sync:env:prod": "tsx scripts/sync-env.ts --prod --confirm",
    "sync:env:prod:preview": "tsx scripts/sync-env.ts --prod",
    "test": "vitest run",
    "test:sandbox": "vitest run convex/stripe/sandbox_contract.test.ts",
    "test:sandbox:preflight": "tsx scripts/stripe_sandbox_preflight.ts",
    "typecheck": "cd .. && pnpm convex typecheck"
  },
  "dependencies": {
    "@convex-dev/better-auth": "catalog:",
    "@convex-dev/migrations": "^0.3.5",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/resend": "^0.2.5",
    "@convex-dev/workpool": "^0.4.7",
    "@djpanda/convex-authz": "^2.4.1",
    "@react-pdf/renderer": "^4.5.1",
    "better-auth": "catalog:",
    "convex": "^1.42.1",
    "convex-helpers": "^0.1.120",
    "fontkit": "^2.0.4",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "resend": "^6.16.0",
    "stripe": "^22.3.1"
  },
  "devDependencies": {
    "@codecov/vite-plugin": "^2.0.1",
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@tiptap/core": "3.28.0",
    "@tiptap/extension-bold": "3.28.0",
    "@tiptap/extension-document": "3.28.0",
    "@tiptap/extension-hard-break": "3.28.0",
    "@tiptap/extension-heading": "3.28.0",
    "@tiptap/extension-image": "3.28.0",
    "@tiptap/extension-italic": "3.28.0",
    "@tiptap/extension-link": "3.28.0",
    "@tiptap/extension-list": "3.28.0",
    "@tiptap/extension-paragraph": "3.28.0",
    "@tiptap/extension-text": "3.28.0",
    "@tiptap/html": "3.27.3",
    "@types/fontkit": "2.0.9",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitest/coverage-v8": "^4.1.9",
    "convex-test": "^0.0.52",
    "eslint": "^10.6.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "vitest-mock-extended": "^4.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
