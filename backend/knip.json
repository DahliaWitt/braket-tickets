{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "entry": [
    "convex/*.ts!",
    "convex/*.tsx!",
    "convex/*/*.ts!",
    "convex/*/*.tsx!",
    "convex/*/*/*.ts!",
    "convex/*/*/*.tsx!",
    "!convex/**/_impl/**!",
    "!convex/lib/**!",
    "!convex/testing/**!",
    "!convex/migrations/**!",
    "!convex/**/*.test.ts!"
  ],
  "project": [
    "convex/**/*.ts!",
    "convex/**/*.tsx!",
    "!convex/**/*.test.ts!",
    "!convex/**/*.test.tsx!",
    "!convex/_generated/**!",
    "!convex/testing/**!",
    "!convex/migrations/**!"
  ],
  "ignoreDependencies": ["agent"]
}
