# GitHub Actions Runner Configuration
# Copy to .env and fill in values.
#
# Generate ACCESS_TOKEN at: https://github.com/settings/tokens
# Required scope: repo (for repo-level runners)
# Or use a GitHub App: set APP_ID + APP_PRIVATE_KEY instead

# Repository URL (required)
REPO_URL=https://github.com/YOUR_ORG/braket-tickets

# Personal access token with repo scope (required unless using GitHub App)
ACCESS_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Runner scope: "repo" (default) or "org"
RUNNER_SCOPE=repo

# Organization name (required only if RUNNER_SCOPE=org)
# ORG_NAME=your-org
